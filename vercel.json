{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/style.css", "destination": "/style.css" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/room", "destination": "/app.html" },
    { "source": "/room/(.*)", "destination": "/app.html" },
    { "source": "/app", "destination": "/app.html" },
    { "source": "/owner", "destination": "/owner-panel.html" },
    { "source": "/admin", "destination": "/owner-panel.html" },
    { "source": "/maintenance", "destination": "/maintenance.html" },
    { "source": "/api/(.*)", "destination": "/index.js" },
    { "source": "/(.*)", "destination": "/index.js" }
  ]
}
