{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/system",
      "destination": "/api/system"
    },
    {
      "source": "/api/admin",
      "destination": "/api/admin"
    },
    {
      "source": "/jhvbuihedfbyhibrt5gi-owner-j42n5jhn",
      "destination": "/jhvbuihedfbyhibrt5gi-owner-j42n5jhn.html"
    },
    {
      "source": "/api/verify",
      "destination": "/api/verify"
    },
    {
      "source": "/api/webhook/log",
      "destination": "/api/webhook"
    },
    {
      "source": "/api/webhook",
      "destination": "/api/webhook"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/style.css",
      "destination": "/style.css"
    },
    {
      "source": "/maintenance",
      "destination": "/maintenance.html"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/room/(.*)",
      "destination": "/app.html"
    },
    {
      "source": "/room",
      "destination": "/app.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
