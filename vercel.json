{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/maintenance",
      "destination": "/maintenance.html"
    },
    {
      "source": "/maintenance/(.*)",
      "destination": "/maintenance.html"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/app/(.*)",
      "destination": "/app.html"
    },
    {
      "source": "/room",
      "destination": "/app.html"
    },
    {
      "source": "/room/(.*)",
      "destination": "/app.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/login/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/api/webhook/log",
      "destination": "/api/webhook.js"
    }
  ]
}
