{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/jhvbuihedfbyhibrt5gi-owner-j42n5jhn",
      "destination": "/jhvbuihedfbyhibrt5gi-owner-j42n5jhn.html"
    },
    {
      "source": "/jhvbuihedfbyhibrt5gi-owner-j42n5jhn/(.*)",
      "destination": "/jhvbuihedfbyhibrt5gi-owner-j42n5jhn.html"
    },
    {
      "source": "/api/auth",
      "destination": "/api/auth.js"
    },
    {
      "source": "/api/auth/(.*)",
      "destination": "/api/auth.js"
    },
    {
      "source": "/api/verify",
      "destination": "/api/verify.js"
    },
    {
      "source": "/api/verify/(.*)",
      "destination": "/api/verify.js?sessionId=$1"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/room",
      "destination": "/room.html"
    }
  ]
}
