# 1. Discord Bot Credentials (From Discord Developer Portal)
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_GUILD_ID=your_discord_guild_server_id_here

# 2. Permissions (Who can run Discord Admin Slash Commands)
# Comma-separated list of Discord user IDs or Role IDs
OWNER_USER_IDS=your_discord_user_id
ADMIN_ROLE_IDS=your_admin_role_id

# 3. Microservice API Settings (For Website Verification)
PORT=4000
# Shared secret for Vercel /api/verify to authenticate with this VPS
API_SECRET=iusedhfiuhsdilufhdsijfh_secret_vps_token

# 4. Master Authority Key (Rotated)
MASTER_KEY=iusedhfiuhsdilufhdsijfh

